{
  "config": {
    "timeoutSeconds": 60,
    "request": {
      "requestType": "POST",
      "requestTemplate": "{\n  \"conversationId\": \"${input.conversationId}\",\n  \"surveyId\": \"${input.surveyId}\",\n  \"surveyName\": \"${input.surveyName}\",\n  \"surveyVersion\": ${input.surveyVersion},\n  \"questionName\": \"${input.questionName}\",\n  \"questionType\": \"${input.questionType}\",\n  \"value\": \"${input.value}\",\n  \"isCompleted\": ${input.isCompleted}\n}",
      "requestUrlTemplate": "{{DOMAIN_NAME}}/api/survey-responses",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "${authResponse.token_type} ${authResponse.access_token}"
      }
    },
    "response": {
      "translationMap": {},
      "translationMapDefaults": {},
      "successTemplate": "${rawResult}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": { "type": "string" },
          "surveyId": { "type": "string" },
          "surveyName": { "type": "string" },
          "surveyVersion": { "type": "integer" },
          "questionName": { "type": "string" },
          "questionType": { "type": "string" },
          "value": { "type": "string" },
          "isCompleted": { "type": "boolean" }
        }
      }
    },
    "output": {
      "successSchema": {
        "type": "object",
        "properties": {}
      }
    }
  }
}

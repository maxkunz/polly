{
  "config": {
    "request": {
      "requestType": "POST",
      "requestTemplate": "{\"conversationId\":\"$esc.jsonString($input.conversationId)\",\"surveyId\":\"$esc.jsonString($input.surveyId)\"\n#if($input.surveyName)\n,\"surveyName\":\"$esc.jsonString($input.surveyName)\"\n#end\n#if($input.surveyVersion)\n,\"surveyVersion\":$input.surveyVersion\n#end\n#if($input.questionName)\n,\"questionName\":\"$esc.jsonString($input.questionName)\"\n#end\n#if($input.questionType)\n,\"questionType\":\"$esc.jsonString($input.questionType)\"\n#end\n#if($input.value)\n#if($input.questionType == \"rating\" || $input.questionType == \"nps\" || $input.questionType == \"yes_no\")\n,\"value\":$input.value\n#else\n,\"value\":\"$esc.jsonString($input.value)\"\n#end\n#end\n#if($input.isCompleted)\n,\"isCompleted\":$input.isCompleted\n#end\n}",
      "requestUrlTemplate": "{{DOMAIN_NAME}}/api/survey-responses",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "${authResponse.token_type} ${authResponse.access_token}"
      }
    },
    "response": {
      "translationMap": {
        "message": "$.message",
        "status": "$.session.status",
        "responseId": "$.session.responseId"
      },
      "translationMapDefaults": {
        "message": "''",
        "status": "''",
        "responseId": "''"
      },
      "successTemplate": "{\"message\": \"$message\", \"status\": \"$status\", \"responseId\": \"$responseId\"}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": { "type": "string" },
          "surveyId": { "type": "string" },
          "surveyName": { "type": "string" },
          "surveyVersion": { "type": "integer" },
          "questionName": { "type": "string" },
          "questionType": { "type": "string" },
          "value": { "type": "string" },
          "isCompleted": { "type": "boolean" }
        },
        "required": ["conversationId", "surveyId"]
      }
    },
    "output": {
      "successSchema": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "status": { "type": "string" },
          "responseId": { "type": "string" }
        }
      }
    }
  }
}

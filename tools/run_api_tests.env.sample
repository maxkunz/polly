# Vorlage für tools/run_api_tests.env (cp run_api_tests.env.sample run_api_tests.env, Werte eintragen)
# Alles zurücksetzen
export GENESYS_TOKEN=
export SURVEY_ID=
export EXISTING_SURVEY_ID=
export API_URL=
export DATATABLE_ID=
export API_CLIENT_ID=
export API_CLIENT_SECRET=
export API_TOKEN_URL=

# defaults
export WEB_THEME_WRITE=1
export GENESYS_REGION=mypurecloud.de


# Pflicht
export GENESYS_TOKEN=""   # Bearer der Polly-App (Dev-Tools, Polly-iframe), nicht das des Portals
export SURVEY_ID=""       # Umfrage-UUID, muss in der Data Table dieser Installation existieren
export API_URL=""         # Basis-URL inkl. Präfix, z. B. https://<app>.amplifyapp.com/api
export EXISTING_SURVEY_ID=""			# Umfrage-UUID einer Test Umfrage mit Ergebnissen
export GENESYS_REGION="mypurecloud.de"	# Genesys Region

# Optional (leer = entsprechende Fälle werden übersprungen)
export DATATABLE_ID=""    # Data Table der Umfragen: echte Fragen aus Prod, Lösch-Tests [D1]–[D4]
export API_CLIENT_ID=""   # Kunden-API /ext/v1 ([C1]–[C21]): Client-ID mit allen drei Scopes
export API_CLIENT_SECRET=""
export API_TOKEN_URL=""   # …/oauth2/token
